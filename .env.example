# BharatYatra Environment Variables Configuration

# Secret API Key for securing external API access (Mandatory in production)
BHARATYATRA_API_KEY=your_secure_random_api_key_here

# Allowed Origins for API Access (Comma-separated exact origins)
ALLOWED_ORIGINS=http://localhost:3000,https://bharatyatra.vercel.app

# Upstash Redis REST API Credentials for Serverless / Edge Rate Limiting (Optional, falls back to in-memory)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

# Next.js Server Port (Optional, defaults to 3000)
PORT=3000

# Node Environment
NODE_ENV=development
